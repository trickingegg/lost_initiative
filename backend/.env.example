# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: gemini | openai | deepseek | groq | openrouter | ollama | openai_compatible
AI_PROVIDER=gemini

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── DeepSeek ──────────────────────────────────────────────────────────────────
# AI_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_MODEL=deepseek-chat          # or deepseek-reasoner

# ── OpenAI ────────────────────────────────────────────────────────────────────
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Groq (fast open-source models) ───────────────────────────────────────────
# AI_PROVIDER=groq
# OPENAI_API_KEY=your_groq_api_key_here
# OPENAI_MODEL=llama3-70b-8192
# OPENAI_JSON_MODE=false

# ── OpenRouter (access to 100+ models via one key) ────────────────────────────
# AI_PROVIDER=openrouter
# OPENAI_API_KEY=your_openrouter_api_key_here
# OPENAI_MODEL=anthropic/claude-3.5-sonnet

# ── Ollama (local, no API key needed) ─────────────────────────────────────────
# AI_PROVIDER=ollama
# OPENAI_MODEL=llama3
# OPENAI_JSON_MODE=false

# ── Generic OpenAI-compatible (any custom endpoint) ───────────────────────────
# AI_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://your-endpoint.com/v1
# OPENAI_MODEL=your-model-name
# OPENAI_JSON_MODE=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./game.db

# ── Server ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Context limits ────────────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=25
MAX_MEMORY_EVENTS=10
